{
  "$schema": "node_modules/wrangler/config-schema.json",
  // A Cloudflare Pages project: the Vite build is the site, functions/ handles /api/*.
  // Pages, unlike Workers, can serve a subdomain whose DNS stays at another provider (Porkbun).
  "name": "atlas",
  "pages_build_output_dir": "./dist/public",
  "compatibility_date": "2026-09-27",
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "SUPABASE_URL": "https://vjlxfznnocovxnaykhst.supabase.co",
    // Publishable, safe to ship. The secret key is set separately with `wrangler pages secret put`.
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_4xypB-PCP0K4jrNLC9H_GQ_Md975aEg",
    "AI_MODEL": "@cf/google/gemma-4-26b-a4b-it"
  }
}
